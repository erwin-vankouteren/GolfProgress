# Editors write the same line endings that .gitattributes stores, so saving a
# file never shows up as a line-ending change (#21). Indentation follows each
# platform's usual style (#58).
root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,xml,config}]
indent_size = 2

[*.{swift,kt,kts}]
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

# Visual Studio writes solution files with tabs.
[*.sln]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf

# ktlint (#77): Compose functions are PascalCase by convention.
[*.{kt,kts}]
ktlint_function_naming_ignore_when_annotated_with = Composable
