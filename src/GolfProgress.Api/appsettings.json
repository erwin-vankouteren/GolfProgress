{
  "//": "Secrets are never stored in this file. Supply ConnectionStrings:DefaultConnection and Jwt:Key via user-secrets (development) or environment variables / Key Vault (deployed). Startup fails fast with a readable message if either is missing.",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "GolfProgress.Api",
    "Audience": "GolfProgress.Mobile",
    "Key": "",
    "ExpiresMinutes": 15
  },
  "RefreshTokens": {
    "ExpiresDays": 14
  },
  "Progress": {
    "BaselineWindowRounds": 5
  },
  "EventRetention": {
    "Enabled": true,
    "RetentionDays": 365,
    "PurgeIntervalHours": 24
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ClientConfig": {
    "MinimumVersions": {
      "Ios": "1.0.0",
      "Android": "1.0.0",
      "Web": "1.0.0"
    }
  },
  "RateLimiting": {
    "Anonymous": {
      "PerIpPermitLimit": 60,
      "PerIpWindowSeconds": 60
    },
    "Auth": {
      "PerIpPermitLimit": 10,
      "PerIpWindowSeconds": 60,
      "PerIpBurstLimit": 30,
      "SessionPerIpPermitLimit": 300,
      "SessionPerIpWindowSeconds": 60,
      "PerEmailPermitLimit": 5,
      "PerEmailWindowSeconds": 300
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
