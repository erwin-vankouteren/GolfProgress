# Line endings are decided here rather than by each machine's core.autocrlf, so
# every clone behaves the same (#21). Text files are stored and checked out with
# LF on every platform; Visual Studio, VS Code, dotnet and sqlcmd all handle LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF, which cmd.exe requires.
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binary content.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.jar  binary
*.pdf  binary
