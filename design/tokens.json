{
  "$comment": "The GolfProgress design tokens (#73): the single source for every client's colours, type, spacing and shape. Edit here, then run `node design/build-tokens.mjs` to regenerate each platform's file. Colours are sRGB hex. Sizes are CSS px / iOS pt / Android dp (sp for text).",

  "color": {
    "light": {
      "background": "#F7F8F5",
      "surface": "#FFFFFF",
      "surfaceVariant": "#EEF1EA",
      "border": "#D9DED4",
      "borderStrong": "#6E786B",
      "textPrimary": "#1B1F1A",
      "textSecondary": "#4D564B",
      "primary": "#1F6F43",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#D4EDDC",
      "onPrimaryContainer": "#0B3D21",
      "error": "#B3261E",
      "onError": "#FFFFFF",
      "success": "#1E7B34",
      "warning": "#8A5300",
      "info": "#1F5FA8",
      "pillarExecution": "#2563EB",
      "pillarDamageControl": "#C2410C",
      "pillarConsistency": "#7C3AED",
      "pillarHabits": "#15803D",
      "confidenceLow": "#A04E05",
      "confidenceMedium": "#1D4ED8",
      "confidenceHigh": "#15803D"
    },
    "dark": {
      "background": "#121411",
      "surface": "#1B1E1A",
      "surfaceVariant": "#262A25",
      "border": "#3C4239",
      "borderStrong": "#8C9688",
      "textPrimary": "#E6EAE3",
      "textSecondary": "#B5BDB0",
      "primary": "#7BD49B",
      "onPrimary": "#003919",
      "primaryContainer": "#1C5235",
      "onPrimaryContainer": "#BDF0CE",
      "error": "#F2B8B5",
      "onError": "#601410",
      "success": "#7CD992",
      "warning": "#F5B65A",
      "info": "#9CC4FF",
      "pillarExecution": "#7AA7FF",
      "pillarDamageControl": "#FF9A62",
      "pillarConsistency": "#B79BFF",
      "pillarHabits": "#6FD68F",
      "confidenceLow": "#F5B65A",
      "confidenceMedium": "#9CC4FF",
      "confidenceHigh": "#7CD992"
    }
  },

  "contrast": {
    "$comment": "Pairs checked in both themes. Text must reach WCAG 2.1 AA 4.5:1; graphics (chart marks, input borders, icons) 3:1 (WCAG 1.4.11). A colour pair used for text but not listed here is a bug.",
    "text": [
      ["textPrimary", "background"],
      ["textPrimary", "surface"],
      ["textPrimary", "surfaceVariant"],
      ["textSecondary", "background"],
      ["textSecondary", "surface"],
      ["textSecondary", "surfaceVariant"],
      ["primary", "surface"],
      ["primary", "background"],
      ["onPrimary", "primary"],
      ["onPrimaryContainer", "primaryContainer"],
      ["onError", "error"],
      ["error", "surface"],
      ["success", "surface"],
      ["warning", "surface"],
      ["info", "surface"],
      ["confidenceLow", "surface"],
      ["confidenceMedium", "surface"],
      ["confidenceHigh", "surface"]
    ],
    "graphics": [
      ["borderStrong", "surface"],
      ["pillarExecution", "surface"],
      ["pillarDamageControl", "surface"],
      ["pillarConsistency", "surface"],
      ["pillarHabits", "surface"],
      ["primary", "surface"]
    ]
  },

  "typography": {
    "$comment": "Each style maps to a platform text style that scales with the user's font-size setting (iOS Dynamic Type, Android sp, browser zoom).",
    "display": { "size": 34, "lineHeight": 41, "weight": 700, "ios": "largeTitle" },
    "title": { "size": 28, "lineHeight": 34, "weight": 600, "ios": "title" },
    "headline": { "size": 22, "lineHeight": 28, "weight": 600, "ios": "title2" },
    "body": { "size": 17, "lineHeight": 22, "weight": 400, "ios": "body" },
    "callout": { "size": 16, "lineHeight": 21, "weight": 400, "ios": "callout" },
    "label": { "size": 15, "lineHeight": 20, "weight": 500, "ios": "subheadline" },
    "caption": { "size": 13, "lineHeight": 18, "weight": 400, "ios": "footnote" }
  },

  "spacing": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },

  "radius": { "sm": 4, "md": 8, "lg": 16, "full": 999 },

  "elevation": { "none": 0, "low": 1, "medium": 3, "high": 6 },

  "touchTarget": {
    "$comment": "Minimum interactive size: 44 on iOS and the web (pt / CSS px), 48 on Android (dp).",
    "ios": 44,
    "web": 44,
    "android": 48
  }
}
