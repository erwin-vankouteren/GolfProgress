{
  "name": "golfprogress-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GolfProgress web app (React).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../../api/openapi.json --output src/api/schema.d.ts",
    "postinstall": "npm run generate:api",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "predev": "npm run generate:api",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.4",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
