<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (#71): the session store never leaves the device, neither in a cloud
     backup nor in a device-to-device transfer. Its key stays in this device's Keystore
     anyway, so a copied token couldn't be decrypted. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
